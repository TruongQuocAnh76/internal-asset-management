//   asset_id String @db.Uuid

//   kit   AssetsKits @relation(fields: [kit_id], references: [id])
//   asset Assets     @relation(fields: [asset_id], references: [id])

//   @@unique([kit_id, asset_id])
// }

model AssetsAllocation {
  id       String @id @default(uuid()) @db.Uuid
  asset_id String @db.Uuid

  kit_id  String? @db.Uuid
  user_id String? @db.Uuid

  allocated_at DateTime  @default(now())
  returned_at  DateTime?

  allocated_by String? @db.Uuid

  asset Assets      @relation(fields: [asset_id], references: [id])
  kit   AssetsKits? @relation(fields: [kit_id], references: [id])
  user  Users?      @relation(fields: [user_id], references: [id])
}

enum DeploymentStatus {
  ACTIVE
  SUSPENDED
}

model Users {
  id         String           @id @default(uuid()) @db.Uuid
  username   String           @unique
  email      String           @unique
  password   String
  first_name String
  last_name  String
  department String
  status     DeploymentStatus
  created_at DateTime         @default(now())
  updated_at DateTime         @default(now())

  asset_events      AssetsEvents[]
  user_roles        UserRoles[]
  audit_logs        AuditLogs[]
  asset_allocations AssetsAllocation[]
  borrow_requests   BorrowRequests[]
}

model Roles {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique

  user_roles       UserRoles[]
  role_permissions RolePermissions[]
}

model UserRoles {
  user_id     String   @db.Uuid
  role_id     String   @db.Uuid
  assigned_at DateTime @default(now())

  user Users @relation(fields: [user_id], references: [id])
  role Roles @relation(fields: [role_id], references: [id])

  @@unique([user_id, role_id])
}

model Permissions {
  id       String @id @default(uuid()) @db.Uuid
  name     String @unique
  resource String @unique
  action   String @unique

  role_permissions RolePermissions[]
}

model RolePermissions {
  role_id       String @db.Uuid
  permission_id String @db.Uuid

  role       Roles       @relation(fields: [role_id], references: [id])
  permission Permissions @relation(fields: [permission_id], references: [id])

  @@unique([role_id, permission_id])
}

enum BorrowStatus {
  PENDING
  PROVIDED
  APPROVED
  REJECTED
  OVERDUE
  CANCELED
  RETURNED
}

enum BorrowPriority {
  LOW
  MEDIUM
  HIGH
}

model BorrowRequests {
  id           String         @id @default(uuid()) @db.Uuid
  asset_id     String?        @db.Uuid
  kit_id       String?        @db.Uuid
  requester_id String         @db.Uuid
  requested_at DateTime       @default(now())
  status       BorrowStatus   @default(PENDING)
  reason       String?
  priority     BorrowPriority @default(LOW)
  approved_at  DateTime?
  approved_by  String?        @db.Uuid
  provided_at  DateTime?
  provided_by  String?        @db.Uuid
  returned_at  DateTime?
  created_at   DateTime       @default(now())

  asset Assets?     @relation(fields: [asset_id], references: [id])
  kit   AssetsKits? @relation(fields: [kit_id], references: [id])
  user  Users       @relation(fields: [requester_id], references: [id])
}

enum Entity {
  ASSET
  ASSET_KIT
  KIT_ITEM
  USER
  CATEGORY
  BORROW_REQUEST
  ASSET_ALLOCATION
}

model AuditLogs {
  id          String   @id @default(uuid()) @db.Uuid
  actor_id    String   @db.Uuid
  action      String
  entity_type Entity
  entity_id   String   @db.Uuid
  before      Json
  after       Json
  created_at  DateTime @default(now())

  user Users @relation(fields: [actor_id], references: [id])
}

model Session {
  id        String   @id
  sid       String   @unique
  data      String
  expiresAt DateTime
}