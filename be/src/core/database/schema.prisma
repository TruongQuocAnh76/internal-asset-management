// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum AssetStatus {
  READY
  IN_USE
  MAINTAINANCE
  BROKEN
  LIQUIDATED
}

model Assets {
  id String @id @default(uuid()) @db.Uuid
  code String @unique
  name String 
  category_id String @db.Uuid
  status AssetStatus @default(READY)
  location_id String @db.Uuid
  costs BigInt @default(0)
  kit_id String? @db.Uuid
  kit_status Boolean @default(false)
  acquired_at DateTime @default(now())
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  asset_specs AssetsSpecs?
  asset_events AssetsEvents[] @relation("AssetToEvents")
  category AssetsCategories @relation(fields: [category_id], references: [id])
  asset_allocation AssetsAllocation[]
  borrow_requests BorrowRequests[]
}

model AssetsCategories {
  id String @id @default(uuid()) @db.Uuid
  code String @unique
  name String

  assets Assets[]
}

model AssetsSpecs {
  asset_id String @id @db.Uuid
  specs Json

  asset Assets? @relation(fields: [asset_id], references: [id])
}

model AssetsEvents {
  id String @id @default(uuid()) @db.Uuid
  asset_id String @db.Uuid
  event_type String 
  actor_id String @db.Uuid
  allocation_id String @db.Uuid
  occured_at DateTime @default(now())
  previous_status AssetStatus
  new_status AssetStatus
  payload Json
  created_at DateTime @default(now())

  asset Assets @relation("AssetToEvents", fields: [asset_id], references: [id])
  user Users @relation(fields: [actor_id], references: [id])
}

model AssetsKits {
  id String @id @default(uuid()) @db.Uuid
  name String 
  status AssetStatus @default(READY)
  created_at DateTime @default(now())

  asset_allocations AssetsAllocation[]
}

model AssetsAllocation {
  id String @id @default(uuid()) @db.Uuid
  asset_id String @db.Uuid

  kit_id String? @db.Uuid
  user_id String? @db.Uuid

  allocated_at DateTime @default(now())
  returned_at DateTime?

  allocated_by String? @db.Uuid

  asset Assets @relation(fields: [asset_id], references: [id])
  kit AssetsKits? @relation(fields: [kit_id], references: [id])
  user Users? @relation(fields: [user_id], references: [id])
}

enum DeploymentStatus {
  ACTIVE
  SUSPENDED
}
model Users {
  id String @id @default(uuid()) @db.Uuid
  username String @unique
  email String @unique
  password String
  first_name String 
  last_name String
  department String
  status DeploymentStatus
  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  asset_events AssetsEvents[]
  user_roles UserRoles[]
  audit_logs AuditLogs[]
  asset_allocations AssetsAllocation[]
  borrow_requests BorrowRequests[]
}

model Roles {
  id String @id @default(uuid()) @db.Uuid
  name String @unique

  user_roles UserRoles[]
  role_permissions RolePermissions[]
}

model UserRoles {
  user_id String @db.Uuid
  role_id String @db.Uuid
  assigned_at DateTime @default(now())

  user Users @relation(fields: [user_id], references: [id])
  role Roles @relation(fields: [role_id], references: [id])
  @@unique([user_id, role_id])
}

model Permissions {
  id String @id @default(uuid()) @db.Uuid
  name String @unique
  resource String @unique
  action String @unique

  role_permissions RolePermissions[]
}

model RolePermissions {
  role_id String @db.Uuid
  permission_id String @db.Uuid

  role Roles @relation(fields: [role_id], references: [id])
  permission Permissions @relation(fields: [permission_id], references: [id])
  @@unique([role_id, permission_id])
}

enum BorrowStatus {
  PENDING
  PROVIDED
  APPROVED
  REJECTED
  RETURNED
}

model BorrowRequests {
  id String @id @default(uuid()) @db.Uuid
  asset_id String @db.Uuid
  requester_id String @db.Uuid
  requested_at DateTime @default(now())
  status BorrowStatus @default(PENDING)
  approved_at DateTime?
  approved_by String? @db.Uuid
  provided_at DateTime?
  provided_by String? @db.Uuid
  returned_at DateTime?
  created_at DateTime @default(now())

  asset Assets @relation(fields: [asset_id], references: [id])
  user Users @relation(fields: [requester_id], references: [id])
}

model AuditLogs {
  id String @id @default(uuid()) @db.Uuid
  actor_id String @db.Uuid
  action String @unique
  entity_type String
  entity_id String @db.Uuid
  before Json
  after Json
  created_at DateTime @default(now())

  user Users @relation(fields: [actor_id], references: [id])
}

model Session {
  id     String   @id @default(cuid())
  sid    String   @unique
  data   String
  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
