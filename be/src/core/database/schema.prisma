generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AssetStatus {
  READY
  IN_USE
  MAINTAINANCE
  BROKEN
  LIQUIDATED
}

model Assets {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  category_id String   @db.Uuid
  image_urls  String[]
  acquired_at DateTime @default(now())
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  asset_specs        AssetsSpecs?
  asset_events       AssetsEvents[]     @relation("AssetToEvents")
  category           AssetsCategories   @relation(fields: [category_id], references: [id])
  asset_allocation   AssetsAllocation[]
  status             AssetStatus      @default(READY)
  borrow_requests    BorrowRequests[]
  kit_template_items KitTemplateItems[]
  // assets_kits_items AssetsKitsItems[]
  asset_items        AssetItems[]
}

model AssetItems {
  id       String @id @default(uuid()) @db.Uuid
  asset_id String @db.Uuid

  status        AssetStatus @default(READY)
  location_name String?
  costs         BigInt?
  acquired_at   DateTime    @default(now())

  kit_id     String? @db.Uuid
  kit_status Boolean @default(false)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  asset Assets      @relation(fields: [asset_id], references: [id], onDelete: Cascade)
  kit   AssetsKits? @relation(fields: [kit_id], references: [id], onDelete: SetNull)
}

model AssetsCategories {
  id   String @id @default(uuid()) @db.Uuid
  code String @unique
  name String

  assets Assets[]
}

model AssetsSpecs {
  asset_id String @id @db.Uuid
  specs    Json

  asset Assets? @relation(fields: [asset_id], references: [id])
}

model AssetsEvents {
  id              String      @id @default(uuid()) @db.Uuid
  asset_id        String      @db.Uuid
  event_type      String
  actor_id        String      @db.Uuid
  allocation_id   String      @db.Uuid
  occured_at      DateTime    @default(now())
  previous_status AssetStatus
  new_status      AssetStatus
  payload         Json
  created_at      DateTime    @default(now())

  asset Assets @relation("AssetToEvents", fields: [asset_id], references: [id])
  user  Users  @relation(fields: [actor_id], references: [id])
}

model AssetsKits {
  id          String      @id @default(uuid()) @db.Uuid
  template_id String      @db.Uuid
  status      AssetStatus @default(READY)
  created_at  DateTime    @default(now())

  asset_allocations AssetsAllocation[]
  // assets_kits_items AssetsKitsItems[]
  borrowRequests    BorrowRequests[]
  asset_items       AssetItems[]
  template          KitTemplates       @relation(fields: [template_id], references: [id])
}

model KitTemplates {
  id         String      @id @default(uuid()) @db.Uuid
  name       String
  status     AssetStatus @default(READY)
  created_at DateTime    @default(now())

  template_items KitTemplateItems[]
  assetsKits     AssetsKits[]
}

model KitTemplateItems {
  id          String @id @default(uuid()) @db.Uuid
  template_id String @db.Uuid
  asset_id    String @db.Uuid

  template KitTemplates @relation(fields: [template_id], references: [id])
  asset    Assets       @relation(fields: [asset_id], references: [id])
}

